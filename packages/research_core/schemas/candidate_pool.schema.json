{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/candidate_pool.schema.json",
  "title": "CandidatePool",
  "type": "object",
  "required": ["metadata", "source_brief", "candidates"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["pool_id", "site", "generated_at", "discovery_mode"],
      "properties": {
        "pool_id": { "type": "string" },
        "site": { "type": "string" },
        "generated_at": { "type": "string" },
        "discovery_mode": {
          "type": "string",
          "enum": ["mock", "manual_export", "api", "mcp", "imported", "mixed"]
        },
        "data_sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "source_brief": {
      "type": "object",
      "properties": {
        "brief_id": { "type": "string" },
        "site": { "type": "string" },
        "search_scope": { "type": "object" },
        "exclusion_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preference_rules": { "type": "object" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_candidates": { "type": "integer" },
        "continue_count": { "type": "integer" },
        "trial_count": { "type": "integer" },
        "watch_count": { "type": "integer" },
        "drop_count": { "type": "integer" },
        "key_gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "name", "candidate_type", "status", "reason", "missing_data"],
        "properties": {
          "candidate_id": { "type": "string" },
          "name": { "type": "string" },
          "candidate_type": {
            "type": "string",
            "description": "Product direction, keyword direction, scenario direction, or subcategory direction."
          },
          "status": {
            "type": "string",
            "enum": ["继续看", "试做", "观察", "先放弃"]
          },
          "reason": { "type": "string" },
          "appearance_reason": {
            "type": "array",
            "items": { "type": "string" }
          },
          "demand_evidence": {
            "type": "object",
            "properties": {
              "search_signal": { "type": ["string", "number"] },
              "trend_signal": { "type": ["string", "number"] },
              "top100_signal": { "type": ["string", "number"] },
              "source_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "confidence": { "type": "string" }
            },
            "additionalProperties": true
          },
          "competition_structure": {
            "type": "object",
            "properties": {
              "price_band": { "type": "string" },
              "brand_concentration": { "type": ["string", "number"] },
              "seller_concentration": { "type": ["string", "number"] },
              "review_threshold": { "type": ["string", "number"] },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          },
          "new_listing_opportunity": {
            "type": "object",
            "properties": {
              "signal": { "type": "string" },
              "recent_asins": {
                "type": "array",
                "items": { "type": "object" }
              },
              "threshold_note": { "type": "string" }
            },
            "additionalProperties": true
          },
          "preliminary_profit_space": {
            "type": "object",
            "description": "Early proxy only. Formal profit review happens after a candidate enters continue/trial.",
            "properties": {
              "price_band": { "type": "string" },
              "size_weight_assumption": { "type": "string" },
              "fee_pressure": { "type": "string" },
              "confidence": { "type": "string" }
            },
            "additionalProperties": true
          },
          "risk_flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "return_risk": { "type": "object", "additionalProperties": true },
          "ip_compliance_risk": { "type": "object", "additionalProperties": true },
          "data_quality": { "type": "object", "additionalProperties": true },
          "missing_data": {
            "type": "array",
            "items": { "type": "string" }
          },
          "next_step": { "type": "string" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sorftime_verification": {
            "type": "object",
            "description": "Sorftime MCP 验证结果，由 apply_sorftime_verification.py 合并写入",
            "properties": {
              "verified_at": { "type": "string" },
              "early_exploration": {
                "type": "object",
                "properties": {
                  "stage": { "type": "string", "description": "模式一并行初探 / 模式二前置快验" },
                  "conclusion": {
                    "type": "string",
                    "enum": ["值得继续", "建议调整方向", "建议放弃"]
                  },
                  "reason": { "type": "string" }
                },
                "additionalProperties": true
              },
              "category_trend": {
                "type": "object",
                "properties": {
                  "trend_direction": { "type": "string" },
                  "monthly_sales_24m": { "type": "array" },
                  "top3_concentration_trend": { "type": "string" },
                  "new_product_share_trend": { "type": "string" }
                },
                "additionalProperties": true
              },
              "keyword_verification": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "keyword": { "type": "string" },
                    "weekly_search_volume": { "type": "number" },
                    "monthly_search_volume": { "type": "number" },
                    "cpc": { "type": "number" },
                    "seasonality": { "type": "string" },
                    "competitor_count": { "type": "number" },
                    "trend_direction": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              },
              "traffic_terms": {
                "type": "object",
                "properties": {
                  "asin": { "type": "string" },
                  "top_traffic_words": { "type": "array", "items": { "type": "string" } },
                  "gap_opportunities": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": true
              },
              "category_report_snapshot": {
                "type": "object",
                "description": "Sorftime category_report 返回的 Top100 类目快照，可包含 products/product_list/top100/items 等产品列表字段",
                "additionalProperties": true
              },
              "supply_chain_signal": {
                "type": "object",
                "description": "Sorftime ali1688_similar_product 返回的 1688 粗采购价信号",
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
