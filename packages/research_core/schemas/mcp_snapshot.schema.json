{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/mcp_snapshot.schema.json",
  "title": "McpSnapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "stage", "depth", "source_type", "marketplace", "collected_at", "tool_calls", "data_gaps"],
  "properties": {
    "schema_version": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "stage": { "type": "string" },
    "depth": { "type": "string", "enum": ["quick", "deep"] },
    "source_type": { "type": "string", "enum": ["sellersprite_mcp", "sorftime_mcp"] },
    "marketplace": { "type": "string" },
    "collected_at": { "type": "string" },
    "data_window": { "type": ["string", "object"] },
    "tool_calls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/tool_call" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/error" }
    },
    "rate_limit": { "type": "object", "additionalProperties": true },
    "data_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    }
  },
  "definitions": {
    "tool_call": {
      "type": "object",
      "required": ["call_id", "tool_name", "params", "status", "started_at", "finished_at"],
      "properties": {
        "call_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true },
        "status": { "type": "string", "enum": ["success", "empty", "error"] },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "duration_ms": { "type": "number" },
        "response_shape": { "type": "object", "additionalProperties": true },
        "raw_response_path": { "type": "string" },
        "normalized_preview": { "type": ["object", "array"] },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/definitions/error" }
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["timeout", "rate_limited", "invalid_params", "tool_unavailable", "parse_error", "unknown"]
        },
        "message": { "type": "string" },
        "tool_name": { "type": "string" },
        "params_summary": { "type": "object", "additionalProperties": true },
        "retry_after": { "type": ["string", "number"] },
        "fallback_action": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
