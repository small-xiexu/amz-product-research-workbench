{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/import_manifest.schema.json",
  "title": "ManualExportImportManifest",
  "type": "object",
  "required": ["metadata", "files", "data_quality"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["manifest_id", "generated_at", "source_folder"],
      "properties": {
        "manifest_id": { "type": "string" },
        "task_name": { "type": "string" },
        "site": { "type": "string" },
        "generated_at": { "type": "string" },
        "source_folder": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_id", "file_name", "relative_path", "source_type", "parse_status"],
        "properties": {
          "file_id": { "type": "string" },
          "file_name": { "type": "string" },
          "relative_path": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": [
              "seller_sprite_search_results",
              "seller_sprite_market_analysis",
              "seller_sprite_reverse_asin_keywords",
              "amazon_aba_keywords",
              "pdf_snapshot",
              "system_file",
              "unknown"
            ]
          },
          "source_tool": { "type": "string" },
          "data_role": { "type": "string" },
          "parse_status": {
            "type": "string",
            "enum": ["parsed", "ignored", "unsupported", "error"]
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sheet_name", "rows", "cols", "header_row", "detected_role"],
              "properties": {
                "sheet_name": { "type": "string" },
                "rows": { "type": "integer" },
                "cols": { "type": "integer" },
                "header_row": { "type": "integer" },
                "detected_role": { "type": "string" },
                "headers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "required_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "missing_required_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "optional_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "sample_rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": ["string", "number", "boolean", "null"] }
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["available_source_types", "missing_source_types", "warnings"],
      "properties": {
        "available_source_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_source_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
