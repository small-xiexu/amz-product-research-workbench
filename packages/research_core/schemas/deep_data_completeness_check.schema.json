{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/deep_data_completeness_check.schema.json",
  "title": "P4DeepDataCompletenessCheck",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "source_packets",
    "source_snapshots",
    "route_checks",
    "source_coverage",
    "metric_coverage",
    "node_mapping_status",
    "completeness_level",
    "data_gaps",
    "blocking_gaps",
    "required_next_actions",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "p4-deep-contract-v1" },
    "packet_id": { "type": "string", "const": "deep_data_completeness_check" },
    "run_id": { "type": "string", "minLength": 1 },
    "source_packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "route_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/route_check" }
    },
    "source_coverage": { "type": "object", "additionalProperties": true },
    "metric_coverage": { "type": "object", "additionalProperties": true },
    "node_mapping_status": { "type": "object", "additionalProperties": true },
    "completeness_level": { "type": "string", "enum": ["acceptable", "warning", "blocker"] },
    "data_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "blocking_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "required_next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "route_check": {
      "type": "object",
      "anyOf": [
        { "required": ["route_ref"] },
        { "required": ["candidate_ref"] },
        { "required": ["route_id"] }
      ],
      "properties": {
        "route_ref": { "type": "string" },
        "candidate_ref": { "type": "string" },
        "route_id": { "type": "string" },
        "status": { "type": "string" },
        "check_result": { "type": "string" },
        "gap_level": { "type": "string", "enum": ["acceptable", "warning", "blocker"] },
        "data_gaps": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence_ref" }
        }
      },
      "additionalProperties": true
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^.+#.+$"
    }
  },
  "additionalProperties": true
}
