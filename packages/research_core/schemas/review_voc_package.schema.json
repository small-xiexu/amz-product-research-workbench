{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/review_voc_package.schema.json",
  "title": "ReviewVocPackage",
  "type": "object",
  "required": ["metadata", "summary", "pain_points", "highlights", "normalized_reviews"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["package_id", "generated_at", "source_type"],
      "properties": {
        "package_id": { "type": "string" },
        "generated_at": { "type": "string" },
        "source_type": { "type": "string", "enum": ["review_plugin_export"] },
        "candidate_id": { "type": "string" },
        "candidate_name": { "type": "string" },
        "source_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "review_count": { "type": "integer" },
        "asin_count": { "type": "integer" },
        "site_count": { "type": "integer" },
        "date_range": { "type": "object" },
        "rating_distribution": { "type": "object" },
        "sentiment_distribution": { "type": "object" },
        "low_rating_count": { "type": "integer" },
        "media_review_count": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "pain_points": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "highlights": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "opportunity_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hypothesis", "evidence_review_ids"],
        "properties": {
          "name": { "type": "string" },
          "hypothesis": { "type": "string" },
          "evidence_review_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "ai_report_reference": {
      "type": "object",
      "properties": {
        "source_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "text_excerpt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "normalized_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["review_id", "asin", "site", "rating", "review_text"],
        "properties": {
          "review_id": { "type": "string" },
          "asin": { "type": "string" },
          "site": { "type": "string" },
          "rating": { "type": ["number", "string"] },
          "sentiment": { "type": "string" },
          "review_date": { "type": "string" },
          "verified": { "type": "string" },
          "helpful_count": { "type": ["integer", "string"] },
          "variant": { "type": "string" },
          "review_text": { "type": "string" },
          "review_text_zh": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": ["name", "review_count", "evidence"],
      "properties": {
        "name": { "type": "string" },
        "review_count": { "type": "integer" },
        "severity": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["review_id", "asin", "rating", "snippet"],
            "properties": {
              "review_id": { "type": "string" },
              "asin": { "type": "string" },
              "rating": { "type": ["number", "string"] },
              "review_date": { "type": "string" },
              "snippet": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
