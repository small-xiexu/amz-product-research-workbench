{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/selection_brief.schema.json",
  "title": "SelectionBrief",
  "type": "object",
  "required": ["site", "exclusion_rules"],
  "properties": {
    "brief_id": {
      "type": "string",
      "description": "Optional stable id for one selection request."
    },
    "site": {
      "type": "string",
      "description": "Target Amazon marketplace, for example US, CA, UK."
    },
    "created_at": {
      "type": "string",
      "description": "Creation time of this brief."
    },
    "search_scope": {
      "type": "object",
      "description": "Rough direction. It can be empty when the user wants broad discovery.",
      "properties": {
        "free_text": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scenarios": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "exclusion_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Hard boundaries such as medical, children, strong certification, IP risk, oversized, fragile."
    },
    "preference_rules": {
      "type": "object",
      "description": "Soft preferences used for candidate discovery and ranking.",
      "properties": {
        "price_band": { "type": "string" },
        "size_weight": { "type": "string" },
        "seasonality": { "type": "string" },
        "competition": { "type": "string" },
        "new_listing_opportunity": { "type": "string" },
        "return_rate": { "type": "string" }
      },
      "additionalProperties": true
    },
    "supply_chain_advantages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known supply-chain strengths, if any."
    },
    "operator_hypotheses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human assumptions that the system should verify or disprove."
    },
    "product_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional early product attributes that may affect risk screening."
    },
    "risk_tolerance": {
      "type": "object",
      "properties": {
        "compliance": { "type": "string" },
        "ip": { "type": "string" },
        "return_rate": { "type": "string" },
        "seasonality": { "type": "string" }
      },
      "additionalProperties": true
    },
    "deferred_inputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Fields intentionally deferred until candidate profit review."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
