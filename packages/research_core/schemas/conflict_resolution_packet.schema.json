{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/conflict_resolution_packet.schema.json",
  "title": "P4ConflictResolutionPacket",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "source_packets",
    "source_snapshots",
    "metric_basis_checks",
    "comparable_conflicts",
    "non_comparable_items",
    "basis_mismatches",
    "conflict_level",
    "blocking_gaps",
    "required_next_actions",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "p4-deep-contract-v1" },
    "packet_id": { "type": "string", "const": "conflict_resolution_packet" },
    "run_id": { "type": "string", "minLength": 1 },
    "source_packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "metric_basis_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/metric_basis_check" }
    },
    "comparable_conflicts": {
      "type": "array",
      "items": { "$ref": "#/definitions/conflict" }
    },
    "non_comparable_items": {
      "type": "array",
      "items": { "$ref": "#/definitions/non_comparable_item" }
    },
    "basis_mismatches": {
      "type": "array",
      "items": { "$ref": "#/definitions/basis_mismatch" }
    },
    "conflict_level": { "type": "string", "enum": ["none", "warning", "blocker"] },
    "blocking_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "required_next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "conflicts": {
      "description": "Legacy optional field; not part of the P4 CLI contract.",
      "type": "array",
      "items": { "$ref": "#/definitions/conflict" }
    },
    "blocking_conflicts": {
      "description": "Legacy optional field; P4 uses blocking_gaps and conflict_level.",
      "type": "array",
      "items": { "$ref": "#/definitions/conflict" }
    }
  },
  "definitions": {
    "metric_basis_check": {
      "type": "object",
      "required": ["metric_name", "primary_basis", "secondary_basis"],
      "properties": {
        "check_id": { "type": "string" },
        "metric_name": { "type": "string", "minLength": 1 },
        "comparable": { "type": "boolean" },
        "primary_basis": { "$ref": "p4_evidence_packet.schema.json#/definitions/metric_basis" },
        "secondary_basis": { "$ref": "p4_evidence_packet.schema.json#/definitions/metric_basis" },
        "comparability": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "conflict": {
      "type": "object",
      "required": ["conflict_id", "field", "severity", "status"],
      "properties": {
        "conflict_id": { "type": "string", "minLength": 1 },
        "metric_name": { "type": "string" },
        "field": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["minor", "material", "blocking", "basis_mismatch"] },
        "status": { "type": "string", "minLength": 1 },
        "primary_value": {},
        "secondary_value": {},
        "numeric_delta": { "type": "number" },
        "relative_delta": { "type": "number" },
        "metric_basis_check_id": { "type": "string" },
        "metric_basis_ref": { "type": "string" },
        "primary_basis": { "$ref": "p4_evidence_packet.schema.json#/definitions/metric_basis" },
        "secondary_basis": { "$ref": "p4_evidence_packet.schema.json#/definitions/metric_basis" },
        "resolution": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence_ref" }
        }
      },
      "additionalProperties": true
    },
    "non_comparable_item": {
      "type": "object",
      "anyOf": [
        { "required": ["metric_name"] },
        { "required": ["field"] },
        { "required": ["reason"] }
      ],
      "additionalProperties": true
    },
    "basis_mismatch": {
      "type": "object",
      "anyOf": [
        { "required": ["metric_name"] },
        { "required": ["field"] },
        { "required": ["mismatches"] }
      ],
      "additionalProperties": true
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^.+#.+$"
    }
  },
  "additionalProperties": true
}
