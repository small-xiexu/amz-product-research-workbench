{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/p4_evidence_packet.schema.json",
  "title": "P4EvidencePacket",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "primary_source",
    "cross_check_sources",
    "source_snapshot_refs",
    "route_refs",
    "selected_routes",
    "evidence_items",
    "derived_metrics",
    "metric_basis",
    "data_gaps",
    "blocking_gaps",
    "confidence",
    "source_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "p4-deep-contract-v1" },
    "packet_id": {
      "type": "string",
      "enum": ["market_structure_evidence_packet", "search_demand_evidence_packet"]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "primary_source": { "type": "string", "enum": ["sellersprite", "sorftime"] },
    "cross_check_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["sellersprite", "sorftime"] }
    },
    "source_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "route_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "selected_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_item" }
    },
    "derived_metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/derived_metric" }
    },
    "metric_basis": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/metric_basis" }
    },
    "data_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "blocking_gaps": {
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "evidence_item": {
      "type": "object",
      "required": ["item_id", "item_type", "facts", "evidence_refs", "source_refs"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "item_type": { "type": "string", "minLength": 1 },
        "facts": { "type": "object", "additionalProperties": true },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/evidence_ref" }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/evidence_ref" }
        },
        "metric_basis_ref": { "type": "string" },
        "metric_basis": { "$ref": "#/definitions/metric_basis" }
      },
      "anyOf": [
        { "required": ["metric_basis_ref"] },
        { "required": ["metric_basis"] }
      ],
      "additionalProperties": true
    },
    "derived_metric": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {},
        "metric_basis_ref": { "type": "string" },
        "metric_basis": { "$ref": "#/definitions/metric_basis" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence_ref" }
        }
      },
      "anyOf": [
        { "required": ["metric_basis_ref"] },
        { "required": ["metric_basis"] }
      ],
      "additionalProperties": true
    },
    "metric_basis": {
      "type": "object",
      "required": [
        "source_name",
        "tool_name",
        "site",
        "marketplace",
        "currency",
        "time_window",
        "data_window",
        "sample_scope",
        "metric_unit",
        "aggregation_unit",
        "parent_child_basis",
        "collection_method",
        "collected_at",
        "input_lineage"
      ],
      "properties": {
        "source_name": { "type": "string", "enum": ["sellersprite", "sorftime"] },
        "tool_name": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "minLength": 1 },
        "marketplace": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "time_window": { "type": "string", "minLength": 1 },
        "data_window": { "type": "string", "minLength": 1 },
        "sample_scope": { "type": "string", "minLength": 1 },
        "metric_unit": { "type": "string", "minLength": 1 },
        "aggregation_unit": { "type": "string", "minLength": 1 },
        "parent_child_basis": { "type": "string", "minLength": 1 },
        "collection_method": { "type": "string", "minLength": 1 },
        "collected_at": { "type": "string", "minLength": 1 },
        "input_lineage": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^.+#.+$"
    }
  },
  "additionalProperties": true
}
