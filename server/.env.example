# LLM Provider 配置（二选一或都填，网页可切换）
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-sonnet-4-20250514

# API Keys（只放后端，切勿提交）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_BASE_URL=             # 可选：Claude / Anthropic 兼容网关
# OPENAI_BASE_URL=                # 可选：OpenAI / GPT 兼容网关

# 跨域（前端地址）
CORS_ORIGINS=http://localhost:3000

# 会话落盘目录（默认仓库根的 .sessions）
# SESSIONS_DIR=.sessions

# 网页 AI 配置页保存的本地运行时配置（包含密钥，切勿提交）
# APP_CONFIG_PATH=.runtime/ai-config.json

# Sorftime MCP（可在网页「数据源配置」页填写）
# SORFTIME_MCP_URL=https://mcp.sorftime.com
# SORFTIME_MCP_KEY=
