{
  "suite": "amazon-product-research-codex",
  "scope": "Codex mainline only; web is excluded",
  "checks": [
    {
      "name": "render_minimal_research_package",
      "command": "python3 skills/amazon-product-research/evals/run_eval.py render_minimal_research_package",
      "expects_stdout_contains": [
        "generated:",
        "validate_ok:"
      ]
    },
    {
      "name": "compile_core",
      "command": "python3 -m compileall -q packages scripts tests"
    },
    {
      "name": "unit_regression",
      "command": "python3 -m unittest discover -v"
    },
    {
      "name": "delivery_validator_contract",
      "command": "python3 scripts/validate_research_outputs.py <run_dir>",
      "note": "Run after a real seller-sprite/review data run is generated."
    }
  ]
}
